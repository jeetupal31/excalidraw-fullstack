# PostgreSQL connection string (required)
DATABASE_URL="postgresql://user:password@localhost:5432/excalidraw"

# Secret used to sign JWT auth tokens (required) — use a long random value
JWT_SECRET="change-me-to-a-long-random-string"

# Server port (optional)
PORT=3000

# Comma-separated allowed CORS origins (optional)
CORS_ORIGINS="http://localhost:5173"

# Groq API key to enable the AI text-to-diagram feature (optional)
# Get a free key at https://console.groq.com/keys
GROQ_API_KEY=""
GROQ_MODEL="llama-3.3-70b-versatile"
